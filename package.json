  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "24.0.0",
    "@types/three": "0.180.0",
    "meshoptimizer": "1.3.0",
    "puppeteer-core": "^24.0.0",
